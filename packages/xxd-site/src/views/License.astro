---
// 授权与商用（LICENSE-PLAN D153–D160）：非商业免费，商用先联系小小东付费授权；联系方式（微信二维码、X）只放在这一页。
// 真正算数的是仓库根目录的 LICENSE（PolyForm Noncommercial 1.0.0）；这页和 COMMERCIAL.md 讲的是同一件事。中文 / 英文共用，语言看路径。
import Site from "../layouts/Site.astro";
import { langOf } from "../i18n/index.js";
const en = langOf(Astro.url.pathname) === "en";
const REPO = "https://github.com/nevertoday/xxd-ui-kit/blob/main/";
const X = "https://x.com/xiaoxiaodong";
const X_MARK = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>';
const T = en
  ? {
      title: "Commercial license", caption: "Get started",
      lead: "The source is public. Noncommercial use is free; commercial use needs a paid license from XXD first. The license is PolyForm Noncommercial 1.0.0. This page explains it in plain words; the LICENSE text is what counts.",
      h: { free: "Free", paid: "Needs a commercial license", contact: "How to get a license", faq: "Common questions" },
      free: [
        "Learning, research and hobby projects.",
        "Personal projects that charge nothing and show no ads, such as a small extension for yourself or a personal home page.",
        "Use by schools, charities and government bodies for their own work.",
        "Opening issues and suggesting improvements to this project.",
      ],
      freeNote: "You can change and share it freely, as long as the LICENSE (or its URL) and its two Required Notice lines go with it.",
      paidLead: "When in doubt, anything that touches one of these is commercial:",
      paid: [
        "Used in a paid product or service: a paid extension, a membership site, a paid mini program, a SaaS.",
        "Used in an extension, site or mini program with ads or affiliate sales.",
        "Used by a company or team for its work, including internal-only tools and admin pages.",
        "Client work: contracting, freelancing, agency projects.",
        "Selling it or something made from it: templates, themes, course material.",
        "Training or fine-tuning a commercial model on it, or building a commercial AI generation service with it.",
      ],
      contactLead: "Add XXD on WeChat or send a DM on X. Tell us what the product is, whether it's a company or a person, and roughly how many users it has. Price and scope (one product, a whole company, a client project) depend on the case; once agreed, we sign a written license.",
      qrAlt: "XXD's WeChat QR code",
      qrCap: "Scan to add XXD on WeChat",
      qrMobile: "On a phone: long-press to save it, then open it from your photos in WeChat's scanner.",
      x: "Message XXD on X",
      faq: [
        ["What about versions I got under MIT?", "Versions up to and including 2026-11-01 (commit 8aa80f12 and earlier) were released under MIT. If you already have one of those versions, you can keep using it under MIT. Every later version is under the current license."],
        ["What about the code from Kumo?", "The original code from Cloudflare's Kumo in the React components stays under MIT (LICENSE-KUMO). XXD's restyling and additions are under the current license."],
        ["I'm just playing with it and may charge later. Is that OK?", "Yes, go ahead. Get a license before you start charging, add ads, or bring it into a company."],
      ],
      docs: { license: "LICENSE (full text)", commercial: "COMMERCIAL.en.md", path: "COMMERCIAL.en.md" },
    }
  : {
      title: "商用授权", caption: "开始",
      lead: "小小东 UI Kit 的源码是公开的：非商业用途免费，商业用途要先联系小小东付费，取得授权。协议是 PolyForm Noncommercial 1.0.0；这一页用大白话解释它，真正算数的是 LICENSE 原文。",
      h: { free: "不用付费的", paid: "要先取得商业授权的", contact: "怎么取得授权", faq: "几个常见问题" },
      free: [
        "个人学习、研究、做着玩；",
        "不收钱、没有广告的个人项目，比如自己用的小插件、个人主页；",
        "学校、公益组织、政府机构自己用；",
        "给本项目提问题、提改进。",
      ],
      freeNote: "可以随便改、随便分享，只要把 LICENSE（或它的链接）和开头两行 Required Notice 一起带上。",
      paidLead: "拿不准的时候，下面任何一条沾边就算商用：",
      paid: [
        "用在收费的产品或服务里：付费插件、会员网站、收费的小程序、SaaS；",
        "用在有广告或带货的插件、网站、小程序里；",
        "公司或团队在工作里用，包括只在内部用的后台和工具；",
        "给客户做的项目：外包、接单、代做；",
        "把它或者它改出来的东西拿去卖：模板、主题、课程素材；",
        "用它训练或微调商用模型、做成商用的 AI 生成服务。",
      ],
      contactLead: "加小小东的微信，或者在 X 上私信。说清用在什么产品上、公司还是个人、大概多少用户。价格和范围（一个产品、整个公司、外包项目）按情况谈，谈好签一份书面授权。",
      qrAlt: "小小东的微信二维码",
      qrCap: "扫码加小小东微信",
      qrMobile: "手机上：长按保存图片，再用微信扫一扫从相册识别。",
      x: "在 X 上私信小小东",
      faq: [
        ["以前按 MIT 拿到的版本呢？", "2026-11-01 和更早的版本（提交 8aa80f12 和之前）是按 MIT 发布的。已经拿到这些版本的人，可以继续按 MIT 用那一版。之后的版本都按现在的协议。"],
        ["来自 Kumo 的代码呢？", "React 组件里来自 Cloudflare Kumo 的原有代码一直是 MIT（LICENSE-KUMO）。小小东给它换的样子、加的东西，按现在的协议。"],
        ["我先做着玩，以后可能收费，可以吗？", "可以，先用。开始收费、上广告，或者拿给公司用之前，来取得授权就行。"],
      ],
      docs: { license: "LICENSE 原文", commercial: "COMMERCIAL.md", path: "COMMERCIAL.md" },
    };
const headings = Object.entries(T.h).map(([slug, text]) => ({ slug, text }));
---

<Site title={T.title} headings={headings}>
  <header class="site-head">
    <p class="xxd-text" data-variant="caption">{T.caption}</p>
    <h1 class="xxd-text" data-variant="display">{T.title}</h1>
    <p class="site-lead">{T.lead}</p>
  </header>

  <h2 class="site-h2" id="free">{T.h.free}</h2>
  <ul class="site-list">{T.free.map((t) => <li>{t}</li>)}</ul>
  <p class="site-p">{T.freeNote}</p>

  <h2 class="site-h2" id="paid">{T.h.paid}</h2>
  <p class="site-p">{T.paidLead}</p>
  <ul class="site-list">{T.paid.map((t) => <li>{t}</li>)}</ul>

  <h2 class="site-h2" id="contact">{T.h.contact}</h2>
  <p class="site-p">{T.contactLead}</p>
  <div class="xxd-cluster" style="align-items:flex-start;gap:var(--gap-block);margin-top:var(--space-4)">
    <figure style="margin:0;width:160px">
      <img src="/contact/wechat-qr.png" width="160" height="165" alt={T.qrAlt} style="display:block;width:160px;height:auto" />
      <figcaption class="xxd-help" style="margin-top:var(--space-2)">{T.qrCap}<br />{T.qrMobile}</figcaption>
    </figure>
    <a class="xxd-btn" href={X} rel="noopener"><Fragment set:html={X_MARK} />{T.x}</a>
  </div>

  <h2 class="site-h2" id="faq">{T.h.faq}</h2>
  <div class="xxd-group__body">
    {T.faq.map(([q, a]) => (
      <div class="xxd-row"><div class="xxd-row__text"><div class="xxd-row__title">{q}</div><div class="xxd-row__desc">{a}</div></div></div>
    ))}
  </div>
  <div class="xxd-cluster" style="margin-top:var(--space-4)">
    <a class="xxd-btn" href={REPO + "LICENSE"} rel="noopener">{T.docs.license}</a>
    <a class="xxd-btn" data-variant="ghost" href={REPO + T.docs.path} rel="noopener">{T.docs.commercial}</a>
  </div>
</Site>
